# # LAX360 Billing SaaS — Environment Variables Reference
# # ─────────────────────────────────────────────────────────────────
# # Copy this file to .env for local development.
# # On Render, add each variable in the service's Environment tab.
# #
# # ⚠️  NEVER commit .env or real credentials to version control.

# # ── Application ────────────────────────────────────────────────────
# PROJECT_NAME=LAX360 Universal Billing SaaS

# # Generate a strong random key for production:
# #   python -c "import secrets; print(secrets.token_hex(48))"
# SECRET_KEY=change-this-to-a-strong-random-secret-key

# ACCESS_TOKEN_EXPIRE_MINUTES=1440
# REFRESH_TOKEN_EXPIRE_DAYS=7

# # ── MongoDB Atlas ──────────────────────────────────────────────────
# # Full Atlas SRV connection string.  Replace <password> with your DB user password.
# # Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
# #
# # Both MONGO_URI and MONGODB_URI are accepted; set either one.
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/

# DATABASE_NAME=lax360_billing1

# # ── Fallback (local dev only) ──────────────────────────────────────
# # Set True to use an in-memory mock DB when MongoDB is unavailable.
# # MUST be False on Render / production.
# USE_IN_MEMORY_FALLBACK=False

# # ── Render build / start ───────────────────────────────────────────
# # Start Command: uvicorn app.main:app --host 0.0.0.0 --port $PORT
PROJECT_NAME=LAX360 Universal Billing SaaS
SECRET_KEY=change-this-to-a-strong-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
MONGO_URI=mongodb+srv://jai890ai_db_user:jjp@lax360.oohnpcn.mongodb.net/lax360_billing1?retryWrites=true&w=majority&appName=lax360

DATABASE_NAME=lax360_billing1
USE_IN_MEMORY_FALLBACK=False
